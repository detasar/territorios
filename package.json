{
  "name": "territorios",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "verify:migration": "bash scripts/verify-d1-migration.sh",
    "verify:webhook": "node scripts/verify-payment-webhook.mjs",
    "data:provinces": "node scripts/fetch-provinces.mjs"
  },
  "dependencies": {
    "d3-geo": "^3.1.1",
    "drizzle-orm": "0.45.2",
    "next": "16.3.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "stripe": "^19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@cloudflare/vite-plugin": "1.53.1",
    "@cloudflare/workers-types": "5.20260825.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.0",
    "@vitejs/plugin-rsc": "0.5.34",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.2",
    "fast-check": "^4.9.0",
    "jsdom": "^29.1.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "4.125.0"
  },
  "type": "module"
}
